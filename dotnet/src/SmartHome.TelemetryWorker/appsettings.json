{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 8883,
    "ClientId": "smarthome-telemetry-worker",
    "KeepAliveSeconds": 30,
    "ConnectionTimeoutSeconds": 10,
    "ReconnectDelaySeconds": 5,
    "Tls": {
      "CaCertificatePath": "certificates/ca.crt",
      "ClientCertificatePath": "certificates/client.crt",
      "ClientKeyPath": "certificates/client.key"
    }
  }
}
