# PostgreSQL configuration
POSTGRES_DB=smarthome_postgres
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# Connection string for .NET tools running on the host (dotnet ef, dotnet run).
ConnectionStrings__SmartHome=Host=localhost;Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
